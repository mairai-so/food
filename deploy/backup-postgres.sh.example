#!/usr/bin/env bash
set -Eeuo pipefail

: "${DATABASE_URL:?Defina DATABASE_URL no ambiente de produção}"
BACKUP_DIR="${BACKUP_DIR:-/var/backups/miar-ai-food}"
STAMP="$(date -u +%Y%m%dT%H%M%SZ)"
mkdir -p "$BACKUP_DIR"
chmod 700 "$BACKUP_DIR"

OUT="$BACKUP_DIR/miar-${STAMP}.sql.gz"
pg_dump --format=plain --no-owner --no-privileges "$DATABASE_URL" | gzip -9 > "$OUT"
chmod 600 "$OUT"

# Mantém apenas os 14 backups mais recentes no diretório local.
find "$BACKUP_DIR" -maxdepth 1 -type f -name 'miar-*.sql.gz' -printf '%T@ %p\n' \
  | sort -nr | awk 'NR > 14 { $1=""; sub(/^ /, ""); print }' \
  | xargs -r rm -f

printf 'Backup criado: %s\n' "$OUT"
